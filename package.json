{
  "name": "wowo-docs",
  "version": "0.3.0",
  "description": "Local interactive documentation for OpenAPI specifications",
  "type": "module",
  "bin": {
    "wowo": "./dist/bin/wowo.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.mts",
      "import": "./dist/src/index.mjs"
    },
    "./cli": {
      "types": "./dist/src/cli/index.d.mts",
      "import": "./dist/src/cli/index.mjs"
    },
    "./openapi": {
      "types": "./dist/src/openapi/index.d.mts",
      "import": "./dist/src/openapi/index.mjs"
    },
    "./server": {
      "types": "./dist/src/server/server.d.mts",
      "import": "./dist/src/server/server.mjs"
    }
  },
  "files": [
    "dist/",
    "README.md",
    "LICENSE"
  ],
  "author": "Andrian004",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Andrian004/wowo-docs"
  },
  "keywords": [
    "openapi",
    "docs"
  ],
  "types": "./dist/src/index.d.mts",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test",
    "dev": "tsx ./bin/wowo.ts ./examples/main.openapi.yaml",
    "prepack": "npm run typecheck && npm run build"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "chokidar": "^5.0.0",
    "open": "^10.1.0",
    "openapi-types": "^12.1.3",
    "prompts": "^2.4.2",
    "swagger-ui-dist": "^5.17.14",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/prompts": "^2.4.9",
    "tsdown": "^0.23.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
